{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Relative imports name the .ts file that exists, because Node's type stripping runs the
    // source as-is and rewrites nothing; tsc allows that only with noEmit, which this is.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
