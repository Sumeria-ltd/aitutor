%% System context — where each part of AITutor runs, and what talks to what.
%% Derived from CLAUDE.md (stack, platform constraints), ADR 0003, ADR 0006, ADR 0012,
%% ADR 0013 (retrieval), ADR 0014 (the bounded loop), ADR 0015 (the isolation probe).
%% Changed 2026-09-29: retrieval is a managed index, one corpus per learner.
flowchart LR
  L(["Learner<br/>phone or browser"])
  subgraph fb["Firebase"]
    WEB["apps/web · React<br/>served by Firebase Hosting"]
    AUTH["Firebase Auth<br/>email sign-in link — no password"]
  end
  subgraph gcp["Google Cloud — one project"]
    API["apps/api · Hono on Cloud Run<br/>verifies the ID token, resolves the learner,<br/>asserts the owner on every read and write"]
    FS[("Firestore — the one database, and the authority on what exists<br/>learners · events · courses · sessions · materials · summaries")]
    GCS[("Cloud Storage<br/>material files — the gs:// URI lives on the Material record")]
    RAG[("Vertex AI RAG Engine — us-central1<br/>one corpus per learner, never shared<br/>a derived cache, never a second source of truth")]
    GEM["Vertex AI · Gemini<br/>Flash-class by default · global endpoint"]
  end
  OP(["Operator — requirement 0009, later<br/>counts and events only, never content"])
  PR(["Isolation probe — ADR 0015<br/>two real accounts · HTTP only<br/>imports nothing from apps/api"])

  L --> WEB
  WEB -- "sign-in link" --> AUTH
  WEB -- "JSON over HTTPS<br/>Authorization: Bearer ID token" --> API
  API -- "verify token" --> AUTH
  API -- "owner-asserted reads and writes<br/>ADR 0006" --> FS
  API -- "store material" --> GCS
  API -- "import into this learner's corpus<br/>corpus identity from the caller, never the request — ADR 0013" --> RAG
  API -- "retrieve, scoped to the allow-list of ragFile ids<br/>the learner holds right now — ADR 0016" --> RAG
  RAG -. "reads the object at import" .-> GCS
  API -- "bounded retrieval loop, then one structured request — ADR 0014<br/>credential: the service account (ADC), no API key" --> GEM
  OP -. "aggregates of the event stream — ADR 0008" .-> FS
  PR == "attacks the deployed surface on every release<br/>a red result stops the deploy" ==> API
