{
  "mcpServers": {
    "atlassian": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "${JIRA_URL:-https://sumerialtd.atlassian.net}",
        "CONFLUENCE_URL": "${CONFLUENCE_URL:-https://sumerialtd.atlassian.net/wiki}",
        "JIRA_USERNAME": "${ATLASSIAN_EMAIL}",
        "CONFLUENCE_USERNAME": "${ATLASSIAN_EMAIL}",
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "JIRA_PROJECTS_FILTER": "AIT",
        "CONFLUENCE_SPACES_FILTER": "AI"
      }
    }
  }
}
