# Every name the project reads. No real values belong in this file.

# apps/api — Firebase Admin resolves credentials from the environment.
# On Cloud Run this is the service account; locally, point it at a key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8080

# apps/web — Firebase Web SDK, read at build time by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_ORIGIN=http://localhost:8080

# Developer tooling — not read by the app. The Atlassian MCP server that the role skills
# require is declared in .mcp.json and expands these from your shell environment; export
# them in your shell profile, never in a committed file. One API token serves both Jira
# and Confluence (create it at id.atlassian.com → Security → API tokens).
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
