# Every name the project reads. No real values belong in this file.

# apps/api — Firebase Admin resolves credentials from the environment.
# On Cloud Run this is the service account; locally, point it at a key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8080

# apps/web — Firebase Web SDK, read at build time by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_ORIGIN=http://localhost:8080

# Developer tooling — not read by the app. The MCP servers declared in .mcp.json start
# through scripts/mcp-env.sh, which loads this file's git-ignored twin, .env, before the
# server runs; a variable already exported in your shell wins over .env. Put real values
# in .env, never here. One Atlassian API token serves both Jira and Confluence (create it
# at id.atlassian.com → Security → API tokens).
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# GitHub MCP server (.mcp.json), same mechanism. Fine-grained PAT at
# github.com/settings/tokens; needs repo scope for this repository.
GITHUB_PERSONAL_ACCESS_TOKEN=
