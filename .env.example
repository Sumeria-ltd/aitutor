# Every name the project reads. No real values belong in this file.

# apps/api — Firebase Admin resolves credentials from the environment.
# On Cloud Run this is the service account; locally, `gcloud auth application-default login`
# is enough, or point GOOGLE_APPLICATION_CREDENTIALS at a key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=<8080>

# Deployment — read by scripts/deploy.sh (`make deploy`) and scripts/gcp-bootstrap.sh. In
# GitHub Actions the first two come from repository variables of the same name; the rest
# have defaults. GCP_REGION must match the Cloud Run rewrite in firebase.json — deploy.sh
# refuses to run if it does not. Firestore's location is set by the bootstrap and is
# permanent; changing GCP_REGION afterwards moves Cloud Run, not the data.
GCP_REGION=<europe-west1>
CLOUD_RUN_SERVICE=<aitutor-api>
ARTIFACT_REPOSITORY=<aitutor>
RUNTIME_SERVICE_ACCOUNT=<aitutor-api@PROJECT.iam.gserviceaccount.com>
FIREBASE_TOOLS_VERSION=<15.5.1>
# gcp-bootstrap.sh only: the monthly budget ceiling, in the billing account's own currency,
# and the person who is emailed at 50 / 90 / 100 % of it.
BUDGET_AMOUNT=
BUDGET_RECIPIENT=

# apps/web — Firebase Web SDK, read at build time by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_ORIGIN=<http://localhost:8080>

# Developer tooling — not read by the app. The MCP servers declared in .mcp.json start
# through scripts/mcp-env.sh, which loads this file's git-ignored twin, .env, before the
# server runs; a variable already exported in your shell wins over .env. Put real values
# in .env, never here. One Atlassian API token serves both Jira and Confluence (create it
# at id.atlassian.com → Security → API tokens).
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# GitHub MCP server (.mcp.json), same mechanism. Fine-grained PAT at
# github.com/settings/tokens; needs repo scope for this repository.
GITHUB_PERSONAL_ACCESS_TOKEN=
